# Add to ~/.hermes/config.yaml, then restart Hermes (or /reload-mcp).
# Replace <grove> with the folder of this wrapper (hosts/hermes).
mcp_servers:
  leaf:
    command: "<grove>/bin/run"
    args: ["leaf-mcp-editor"]   # or "leaf-mcp" for a read-only server
    env:
      LEAF_WIKI: "/home/you/wiki"
    timeout: 60
