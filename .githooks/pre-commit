#!/bin/sh
# Regenerate hosts/ and the marketplace from core/, and stage the result, so a
# commit never carries a core/ change without its generated files.
# Enable once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 scripts/build.py >/dev/null || exit 1
git add hosts .claude-plugin/marketplace.json
